<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Camera captures are written here and shared with the camera app via the
         FileProvider. -->
    <cache-path name="captures" path="captures/" />
    <!-- Downloaded volume files live under filesDir; the chooser hands them to
         other apps through a temporary read grant. -->
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
</paths>
